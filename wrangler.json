{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "9db9cc3ef28843e7b40258edaf1fe55a"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "GitHubMCP"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitHubMCP"]
    }
  ]
}
